# =============================================================================
# Flash Sale System — environment template
# คัดลอกเป็น .env แล้วแก้ค่าตามเครื่อง:  cp .env.example .env
# ⚠️ ห้าม commit .env (CLAUDE.md §6)
#
# หมายเหตุ: ค่า host ด้านล่างเป็น "ชื่อ service ใน docker-compose"
#   - รันด้วย podman compose  → ใช้ค่าตามนี้ได้เลย
#   - รันแบบ local (pnpm start:dev) → เปลี่ยนเป็น localhost และใช้ port ฝั่ง host
#     (postgres-primary→localhost:5432, postgres-replica→localhost:5433,
#      redis-cache→localhost:6379, redis-data→localhost:6380)
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# ระบุตัวตนของ instance ลงใน log ทุกบรรทัด (app-1 / app-2 / app-3)
INSTANCE_ID=app-1

# --- Auth (JWT HS256, stateless — ไม่มี session ใน memory) -----------------
JWT_SECRET=flash-sale-dev-secret-change-me
JWT_EXPIRES_IN=15m

# --- PostgreSQL Primary (writes ทั้งหมดวิ่งมาที่นี่) ------------------------
DB_HOST=postgres-primary
DB_PORT=5432
DB_USERNAME=flashsale
DB_PASSWORD=flashsale
DB_DATABASE=flashsale

# --- PostgreSQL Replica (catalog read เท่านั้น — ห้ามอ่านของที่ต้อง lock) ---
DB_REPLICA_HOST=postgres-replica
DB_REPLICA_PORT=5432

# ขนาด pool ต่อ DataSource (architecture.md §8)
#   3 instances × (1 master + 1 replica) × 10 = 60 ≤ 80% ของ max_connections(100)
DB_POOL_SIZE=10

# --- Redis #1: cache ล้วน (allkeys-lru) — metadata cache เท่านั้น ----------
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379

# --- Redis #2: data/queue (noeviction + AOF) — stock counter, lock, BullMQ --
#     ⚠️ ห้ามตั้งเป็น allkeys-lru เด็ดขาด (CLAUDE.md §4.11)
REDIS_DATA_HOST=redis-data
REDIS_DATA_PORT=6379

# --- Cache policy ----------------------------------------------------------
# TTL จริง = BASE + random(0..JITTER) วินาที เพื่อกัน cache stampede (§5.3)
CATALOG_CACHE_TTL_BASE=30
CATALOG_CACHE_TTL_JITTER=30

# --- Concurrency -----------------------------------------------------------
# อายุ in-flight lock ของ order (กันกดรัว → 429)
ORDER_LOCK_TTL_MS=30000
# ⚠️ ห้ามเกิน DB_POOL_SIZE — worker แชร์ pool เดียวกับ API (§8)
WORKER_CONCURRENCY=5

# --- Bull-Board (/admin/queues) — ต้องมี Basic Auth คลุมเสมอ ---------------
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin
